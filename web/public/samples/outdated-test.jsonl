{"v":1,"seq":53,"ts":"2026-10-01T09:19:21.352815871Z","run_id":"r-20261001-091918-55914d","stage":"locate","kind":"culprit_found","data":{"commit":{"sha":"f98338b23f6464e47a02fbe58128161d4ec02165","subject":"feat(format)!: show prices with a currency code","author":"Lena Fischer","date":"2026-08-20T20:00:00Z"},"diff":"diff --git a/CHANGELOG.md b/CHANGELOG.md\nindex a5f1ff6..a2c1e6d 100644\n--- a/CHANGELOG.md\n+++ b/CHANGELOG.md\n@@ -9,3 +9,4 @@\n - Added `object.pick`.\n - Added `object.omit`.\n - Added `text.truncate`.\n+- **Breaking:** prices are shown with a currency code (`12.50 USD`) instead of a `$` prefix, everywhere `formatPrice` is used (PRICING-142).\ndiff --git a/README.md b/README.md\nindex 989e5aa..b6d2e18 100644\n--- a/README.md\n+++ b/README.md\n@@ -11,7 +11,7 @@ Requires Node 24. Run the tests with `node --test`.\n \n - `paginate.pageCount(total, size)`: Pages needed for `total` items.\n - `paginate.paginate(items, page, size)`: Items on a 1-based page.\n-- `format.formatPrice(cents)`: Price string such as `$12.50`.\n+- `format.formatPrice(cents)`: Price string such as `12.50 USD`.\n - `cart.cartTotal(items)`: Cart total in cents.\n - `cart.priceLabel(cents)`: Label shown next to a cart line.\n - `retry.backoffDelay(attempt)`: Capped exponential backoff in ms.\ndiff --git a/src/format.js b/src/format.js\nindex 16ced19..79ad960 100644\n--- a/src/format.js\n+++ b/src/format.js\n@@ -1,4 +1,5 @@\n-// Formats an amount in cents as a price, e.g. 1250 -\u003e \"$12.50\".\n+// Formats an amount in cents as a price with its currency code,\n+// e.g. 1250 -\u003e \"12.50 USD\".\n export function formatPrice(cents) {\n-  return `$${(cents / 100).toFixed(2)}`;\n+  return `${(cents / 100).toFixed(2)} USD`;\n }\ndiff --git a/test/format.test.js b/test/format.test.js\nindex 83277cf..c0ac576 100644\n--- a/test/format.test.js\n+++ b/test/format.test.js\n@@ -2,10 +2,11 @@ import { test } from \"node:test\";\n import assert from \"node:assert/strict\";\n import { formatPrice } from \"../src/format.js\";\n \n-test(\"formatPrice shows dollars and cents\", () =\u003e {\n-  assert.equal(formatPrice(1250), \"$12.50\");\n+test(\"formatPrice shows the amount and currency code\", () =\u003e {\n+  assert.equal(formatPrice(1250), \"12.50 USD\");\n+  assert.equal(formatPrice(1999), \"19.99 USD\");\n });\n \n test(\"formatPrice pads whole amounts\", () =\u003e {\n-  assert.equal(formatPrice(500), \"$5.00\");\n+  assert.equal(formatPrice(500), \"5.00 USD\");\n });","rounds":3,"tested":14,"duration_ms":1391}}
